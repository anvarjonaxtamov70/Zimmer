# BotFather'dan olingan token
BOT_TOKEN=123456789:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA

# Admin Telegram ID'lari (vergul bilan ajratiladi). O'z ID'ingizni @userinfobot dan oling
ADMINS=123456789

# Do'kon / servis nomi
SHOP_NAME=Zimmer

# Ma'lumotlar bazasi fayli
DB_PATH=zimmer.db

# Vaqt zonasi
TIMEZONE=Asia/Tashkent

# Ish vaqti (soat) va navbat oralig'i (minut)
WORK_START_HOUR=9
WORK_END_HOUR=18
SLOT_MINUTES=30

# Necha kun oldinga navbat olish mumkin
BOOKING_DAYS_AHEAD=7

# Valyuta
CURRENCY=so'm
