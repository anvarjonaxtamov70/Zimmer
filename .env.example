# ==========================================
# ZIMMER BOT KONFIGURATSIYASI
# ==========================================

# Telegram Bot Token (BotFather'dan olinadi)
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz

# Admin foydalanuvchilar (vergul bilan ajratish)
ADMINS=5105291033,483425630,5302078

# Do'kon nomi
SHOP_NAME=Zimmer

# Vaqt zonasi
TIMEZONE=Asia/Tashkent

# Ish vaqti (24 soatlik format)
WORK_START_HOUR=9
WORK_END_HOUR=18

# Slot davomiyligi (daqiqalarda)
SLOT_MINUTES=30

# Navbat necha kun oldidan band qilish mumkin
BOOKING_DAYS_AHEAD=7

# Valyuta
CURRENCY=so'm

# Mini ilova URL (GitHub Pages yoki boshqa hosting)
MINI_APP_URL=https://anvarjonaxtamov70.github.io/Zimmer/

# ==========================================
# FIREBASE SOZLAMALARI
# ==========================================

# Firebase Realtime Database URL
FIREBASE_DB_URL=https://your-project.firebaseio.com

# Firebase root node nomi (bir necha loyiha uchun)
FIREBASE_ROOT=zimmer

# Firebase Storage Bucket (rasmlar uchun)
FIREBASE_STORAGE_BUCKET=your-project.appspot.com

# Service Account JSON (base64 yoki to'liq JSON)
# Variant 1: base64 encoded (tavsiya etiladi)
SERVICE_ACCOUNT_JSON=eyJ0eXBlIjoic2VydmljZV9hY2NvdW50IiwiCg...

# Variant 2: to'liq JSON (ko'p qatorli)
# SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# Variant 3: fayl yo'li
SERVICE_ACCOUNT_FILE=serviceAccount.json

# ==========================================
# TO'LOV SOZLAMALARI
# ==========================================

# Karta raqami (to'lov uchun)
PAY_CARD_NUMBER=5614 6818 7479 6349

# Karta egasi
PAY_CARD_HOLDER=AXTAMOV ANVARJON

# Admin username (chek yuborish uchun)
PAY_ADMIN_USERNAME=anvaraxtamov2004

# Yetkazib berish shahri
DELIVERY_CITY=Toshkent

# ==========================================
# DEPLOY SOZLAMALARI (Render.com)
# ==========================================

# Keep-alive URL (Render'da avtomatik beriladi)
# KEEP_ALIVE_URL=https://your-app.onrender.com

# Keep-alive interval (soniyalarda)
KEEP_ALIVE_INTERVAL=600

# Mini App initData amal qilish vaqti (soatlarda)
INIT_DATA_MAX_AGE_HOURS=168
