# BotFather'dan olingan token
BOT_TOKEN=123456789:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA

# Admin Telegram ID'lari (vergul bilan). Bo'sh qoldirilsa Avto_A1 dagi
# adminlar ishlatiladi: 5105291033, 483425630, 5302078
# O'z ID'ingizni botga /id yuborib bilib olasiz.
ADMINS=5105291033,483425630,5302078

# Standart adminlarni saqlab, ustiga yangi admin qo'shish uchun:
# ADMINS_EXTRA=123456789

# Do'kon / servis nomi
SHOP_NAME=Zimmer

# Mini App manzili (GitHub Pages). Bot foydalanuvchini shu ilovaga yo'naltiradi.
MINI_APP_URL=https://anvarjonaxtamov70.github.io/Zimmer/

# Lokal sinov uchun API portini ochish (Render'da PORT o'zi beriladi)
# API_PORT=8080

# Ma'lumotlar bazasi fayli
DB_PATH=zimmer.db

# Vaqt zonasi
TIMEZONE=Asia/Tashkent

# Ish vaqti (soat) va navbat oralig'i (minut)
WORK_START_HOUR=9
WORK_END_HOUR=18
SLOT_MINUTES=30

# Necha kun oldinga navbat olish mumkin
BOOKING_DAYS_AHEAD=7

# Valyuta
CURRENCY=so'm


# ---------------------------------------------------------------------------
# Firebase Realtime Database (ixtiyoriy, lekin TAVSIYA ETILADI)
#
# Nima uchun: Render'ning bepul tarifida disk saqlanmaydi — qayta deployda
# SQLite tozalanadi. Firebase ulangan bo'lsa mijozlar va tovarlar doimiy
# saqlanadi va bot qayta ishga tushganda o'zi tiklab oladi.
#
# 1) Firebase Console -> Project settings -> Service accounts ->
#    "Generate new private key" -> yuklab olingan JSON'ning BUTUN matnini
#    (yoki base64 holda) SERVICE_ACCOUNT_JSON ga qo'yasiz.
# 2) Realtime Database manzilini FIREBASE_DB_URL ga yozasiz.
# ---------------------------------------------------------------------------
# FIREBASE_DB_URL=https://avtoa1shop-default-rtdb.firebaseio.com
# FIREBASE_ROOT=zimmer
# SERVICE_ACCOUNT_JSON={"type":"service_account", ...}
