// =====================================================================
//  ZIMMER — Firebase Realtime Database qoidalari
//
//  TAMOYIL: «hammasi yopiq, faqat kerakli joy ochiq».
//
//  Bot service-account tokeni bilan yozadi. Service-account BU QOIDALARNI
//  CHETLAB O'TADI (admin huquqi), shuning uchun hamma joyda `.write: false`
//  bo'lsa ham bot normal ishlaydi. Ya'ni BRAUZERDAN HECH NARSA YOZIB
//  BO'LMAYDI — bu ataylab shunday.
//
//  `catalog` esa OCHIQ O'QILADI: Mini App Render javob bermagan paytda
//  katalogni to'g'ridan-to'g'ri shu tugundan o'qiydi (docs/js/offline.js).
//  Bu do'kon vitrinasi — nom, narx, rasm. Ular baribir ilovada hammaga
//  ko'rinadi, shuning uchun ochiq o'qish yangi ma'lumot oshkor qilmaydi.
//
//  MUHIM: mijozlar (users), buyurtmalar (orders / biled_orders), navbatlar
//  (bookings), saqlanganlar va adminlar — QAT'IY YOPIQ. Ularni faqat bot
//  o'qiy va yoza oladi. `zimmer/products` (Excel import qoralamalari,
//  ta'minotchi narxlari) ham yopiq.
//
//  DEPLOY:
//    firebase deploy --only database
//  yoki: Firebase Console -> Realtime Database -> Rules -> shu matnni qo'yib
//  «Publish» bosish.
//
//  DIQQAT: bu qoidalarni qo'yguncha zaxira rejim ISHLAMAYDI (o'qish rad
//  etiladi). Agar bazada hozir «test mode» (hammasi ochiq) bo'lsa, bu fayl
//  xavfsizlikni ANCHA kuchaytiradi.
// =====================================================================
{
  "rules": {
    ".read": false,
    ".write": false,

    "zimmer": {
      // ---- Do'kon vitrinasi: Mini App zaxira rejimida o'qiydigan yagona joy.
      // RTDB'da qoidalar faqat CHUQURLASHGANDA ruxsat BERADI — shuning uchun
      // yuqoridagi `false` bu tugunga ta'sir qilmaydi.
      "catalog": {
        ".read": true,
        ".write": false
      },

      // ---- Qat'iy yopiq (faqat bot va Worker ko'radi)
      //
      // DIQQAT: Cloudflare Worker service-account tokeni bilan ishlaydi,
      // ya'ni u ham bu qoidalarni CHETLAB O'TADI. Shuning uchun brauzerga
      // hech qanday yozish huquqi berish KERAK EMAS — buyurtma va profil
      // Worker orqali yoziladi. Avto_A1 da brauzer to'g'ridan yozgani
      // uchun unda `users`/`orders` ga ruxsat berilgan va natijada mijoz
      // `total: 0` yoki `status: "yetkazildi"` yozib qo'ya olardi.
      "users": { ".read": false, ".write": false },

      // Botning buyurtma nusxasi (`sync._put_order`) — raqamli SQLite id bilan
      "orders": { ".read": false, ".write": false },

      // Worker qabul qilgan buyurtmalar (Render o'chgan paytda berilgan).
      // ALOHIDA tugun: yuqoridagi `orders` ni bot raqamli id bilan yozadi va
      // `restore_orders` ham raqamli id kutadi — aralashtirsak bir-birini
      // buzardi. Bot bu tugunni o'qib SQLite ga ko'chiradi va `imported: true`
      // deb belgilaydi.
      //
      // `.indexOn`: Worker `/me` da `orderBy="uid"`, bot esa
      // `orderBy="imported"` bilan izlaydi. Indeks bo'lmasa Firebase butun
      // tugunni skanerlaydi va ogohlantirish beradi.
      "pending_orders": {
        ".read": false,
        ".write": false,
        ".indexOn": ["uid", "createdAt", "imported"]
      },

      "biled_orders": { ".read": false, ".write": false },
      "bookings": { ".read": false, ".write": false },
      "favorites": { ".read": false, ".write": false },
      "admins": { ".read": false, ".write": false },
      "products": { ".read": false, ".write": false },
      "products_counter": { ".read": false, ".write": false }
    }
  }
}
