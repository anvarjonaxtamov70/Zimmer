// =====================================================================
//  ZIMMER — Firebase Realtime Database qoidalari
//
//  MODEL: Avto_A1 bilan bir xil — brauzer bazaga TO'G'RIDAN o'qiydi va
//  yozadi. Shuning uchun mini app Render'dan (va hatto Cloudflare
//  Worker'dan) mustaqil ishlaydi: tovar qo'shish, tahrirlash, buyurtma
//  berish — hammasi brauzerdan bajariladi.
//
//  Bu ATAYLAB tanlangan yo'l (loyiha egasining qarori). Ilgari bu yerda
//  hammasi yopiq edi va yozishni faqat Worker bajarardi.
//
//  ---------------------------------------------------------------------
//  NIMA OCHIQ — ro'yxat aniq bo'lsin, keyinchalik yopish oson bo'ladi:
//
//    catalog          o'qish + YOZISH  (tovar, narx, qoldiq, banner...)
//    pending_orders   o'qish + yozish  (buyurtma berish va admin ko'rishi)
//    pending_products o'qish + yozish  (qoralamalar)
//    pending_edits    o'qish + yozish  (tuzatishlar)
//    users            o'qish + yozish  (profil, saqlanganlar)
//    bookings         o'qish + yozish  (navbat)
//    biled_orders     o'qish + yozish  (Bi-LED buyurtmalari)
//    favorites        o'qish + yozish
//    products_counter o'qish + yozish  (yangi tovar id si)
//
//  YOPIQ QOLADI (mini app ularga murojaat qilmaydi):
//    orders           botning SQLite nusxasi — brauzer tegmasligi kerak
//    products         Excel qoralamalari, TA'MINOTCHI NARXLARI
//    admins           adminlar ro'yxati
//
//  ---------------------------------------------------------------------
//  BILIB TURING: baza manzili `docs/config.js` da, GitHub Pages'da ochiq.
//  Yuqoridagi tugunlarni istalgan odam o'qiy va o'zgartira oladi.
//  Loyiha egasi bundan xabardor; bot to'liq tayyor bo'lgach qoidalar
//  qaytadan yopiladi.
//
//  Yopishga qaytish OSON: Worker orqali yozish yo'li (`/order`,
//  `/profile`, `/admin/*`) saqlanib qoldi va ishlashda davom etadi.
//  Faqat shu faylni eski holatga qaytarish kifoya.
//
//  ---------------------------------------------------------------------
//  DEPLOY:
//    Firebase Console -> Realtime Database -> Rules -> shu matnni qo'yib
//    «Publish» bosish.
// =====================================================================
{
  "rules": {
    ".read": false,
    ".write": false,

    "zimmer": {
      // ---- Do'kon vitrinasi: o'qish HAM, yozish HAM ochiq.
      // Admin paneli tovarni to'g'ridan shu yerga yozadi, shuning uchun
      // yangi tovar do'konda DARHOL ko'rinadi (Avto_A1 dagidek).
      "catalog": {
        ".read": true,
        ".write": true,
        "products": {
          // Qidiruv va tartiblash indekslari
          ".indexOn": ["category_id", "car_id", "is_active"]
        }
      },

      // ---- Buyurtmalar (Render o'chgan paytda ham qabul qilinadi).
      // Bot bu tugunni o'qib SQLite ga ko'chiradi va `imported: true` deb
      // belgilaydi — shuning uchun buyurtma botga ham yetib boradi.
      //
      // `.indexOn`: `/me` da `orderBy="uid"`, bot esa `orderBy="imported"`
      // bilan izlaydi. Indeks bo'lmasa Firebase butun tugunni skanerlaydi.
      "pending_orders": {
        ".read": true,
        ".write": true,
        ".indexOn": ["uid", "createdAt", "imported"]
      },

      // ---- Zaxira rejimda qo'shilgan tovarlar va tuzatishlar.
      // Worker yo'li ular bilan ishlaydi; brauzer to'g'ridan katalogga
      // yozgani uchun bu tugunlar endi majburiy emas, lekin ikkala yo'l
      // birga ishlashi uchun ochiq qoldiriladi.
      "pending_products": {
        ".read": true,
        ".write": true,
        ".indexOn": ["imported", "createdAt"]
      },
      "pending_edits": {
        ".read": true,
        ".write": true,
        ".indexOn": ["imported", "updatedAt"]
      },

      // ---- Mijoz ma'lumotlari: profil, saqlanganlar, savat.
      "users": {
        ".read": true,
        ".write": true
      },

      // ---- Navbat va Bi-LED buyurtmalari
      "bookings": {
        ".read": true,
        ".write": true,
        ".indexOn": ["uid", "day", "imported"]
      },
      "biled_orders": {
        ".read": true,
        ".write": true,
        ".indexOn": ["uid", "createdAt", "imported"]
      },
      "favorites": {
        ".read": true,
        ".write": true
      },

      // ---- Yangi tovar id si. Brauzer bu sanoqchini oshirib id oladi.
      // SQLite avto-inkrementi bilan urishmasligi uchun sanoq YUQORI
      // oraliqdan boshlanadi (`docs/js/fb.js`: ID_BASE).
      "products_counter": {
        ".read": true,
        ".write": true
      },

      // ---- YOPIQ QOLADI
      //
      // `orders` — botning SQLite nusxasi (`sync._put_order`), raqamli id
      // bilan. Brauzer bunga yozsa `restore_orders` buziladi.
      "orders": { ".read": false, ".write": false },

      // `products` — Excel importi qoralamalari va TA'MINOTCHI NARXLARI.
      // Bu savdo maxfiyati, vitrinada ko'rinmaydi.
      "products": { ".read": false, ".write": false },

      "admins": { ".read": false, ".write": false }
    }
  }
}
