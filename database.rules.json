{
  "rules": {
    ".read": false,
    ".write": false,

    "zimmer": {
      "catalog": {
        ".read": true,
        ".write": true,
        "products": {
          ".indexOn": ["category_id", "car_id", "is_active"]
        }
      },

      "pending_orders": {
        ".read": true,
        ".write": true,
        ".indexOn": ["uid", "createdAt", "imported"]
      },

      "pending_products": {
        ".read": true,
        ".write": true,
        ".indexOn": ["imported", "createdAt"]
      },

      "pending_edits": {
        ".read": true,
        ".write": true,
        ".indexOn": ["imported", "updatedAt"]
      },

      "users": {
        ".read": true,
        ".write": true
      },

      "bookings": {
        ".read": true,
        ".write": true,
        ".indexOn": ["uid", "day", "imported"]
      },

      "biled_orders": {
        ".read": true,
        ".write": true,
        ".indexOn": ["uid", "createdAt", "imported"]
      },

      "favorites": {
        ".read": true,
        ".write": true
      },

      "products_counter": {
        ".read": true,
        ".write": true
      },

      "orders": { ".read": false, ".write": false },
      "products": { ".read": false, ".write": false },
      "admins": { ".read": false, ".write": false }
    }
  }
}
